# Required: the password for the site.
APP_PASSWORD=change-me
# Optional: extra secret mixed into the login cookie signature.
AUTH_SECRET=
# Optional (recommended): cloud sync + daily backups. Added automatically when you
# connect a Turso database in the Vercel project's Storage tab.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Alternative: Upstash Redis
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Local development only: fake the cloud with a JSON file.
# LOCAL_STORE_FILE=.data/store.json
